# Planilha de produtos publicada como CSV (Arquivo → Compartilhar →
# Publicar na web → aba "produtos" → formato CSV).
# Sem esta variável, o site lê content/fixtures/produtos-demo.csv.
PLANILHA_CSV_URL=

# Measurement ID do GA4 (formato G-XXXXXXXXXX).
# Sem esta variável, nenhum script de analytics é carregado.
NEXT_PUBLIC_GA_ID=
